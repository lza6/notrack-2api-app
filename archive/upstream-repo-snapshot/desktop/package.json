{
  "name": "duckflow-dashboard",
  "version": "1.0.0",
  "description": "DuckFlow 用量看板 - duck.ai OpenAI 兼容网关",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "pack": "electron-builder --win --dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "DuckFlow",
  "build": {
    "appId": "io.duckflow.dashboard",
    "productName": "DuckFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": null
    },
    "portable": {
      "artifactName": "DuckFlow-Portable.exe"
    }
  }
}